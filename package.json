{
  "name": "till",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "build:web": "vite build",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc -b --force",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply till-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply till-db --remote",
    "db:seed:local": "wrangler d1 execute till-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute till-db --remote --file=./seed.sql",
    "seed:gen": "tsx src/worker/seed.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.5",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.43.0"
  }
}
